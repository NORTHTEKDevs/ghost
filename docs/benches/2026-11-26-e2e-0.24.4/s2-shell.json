{"env": {"GHOST_SHELL": "on"}, "steps": [
{"note": "E one-shot shell"},
{"tool": "ghost_shell", "args": {"cmd": "Write-Output 'e2e-one-shot'"}, "expect": "ok", "contains": "e2e-one-shot", "max": 300},
{"tool": "ghost_shell", "args": {"cmd": "echo e2e-cmd", "shell": "cmd"}, "expect": "ok", "contains": "e2e-cmd", "max": 300},
{"tool": "ghost_shell", "args": {"cmd": "Get-Item C:/definitely/not/here"}, "contains": "\"exit_code\":1", "max": 400},
{"tool": "ghost_shell", "args": {"cmd": "Write-Output 1", "cwd": "C:/definitely/not/here"}, "expect": "err", "max": 300},
{"tool": "ghost_shell", "args": {"cmd": "(Get-Location).Path", "cwd": "~"}, "expect": "ok", "contains": "Users", "max": 300},
{"tool": "ghost_shell", "args": {"cmd": "Start-Sleep 30", "timeout_ms": 1500}, "max": 300},
{"note": "F one-shot that FINISHED: a child it started keeps running (by design, unchanged in 0.24.4); ended here by its PID"},
{"tool": "ghost_shell", "args": {"cmd": "$psi = New-Object System.Diagnostics.ProcessStartInfo 'ping.exe','-n 120 127.0.0.1'; $psi.UseShellExecute=$false; $psi.CreateNoWindow=$true; $psi.RedirectStandardOutput=$true; $c=[Diagnostics.Process]::Start($psi); 'CHILD=' + $c.Id"}, "expect": "ok", "capture": {"c1": "CHILD=(\\d+)"}, "max": 300},
{"sleep": 1500},
{"exec": "tasklist /FI \"PID eq {{c1}}\" /NH", "contains": "PING.EXE"},
{"exec": "taskkill /PID {{c1}} /F", "contains": "SUCCESS"},
{"note": "F one-shot that TIMED OUT: the shell and its child end (new in 0.24.4)"},
{"tool": "ghost_shell", "args": {"cmd": "$psi = New-Object System.Diagnostics.ProcessStartInfo 'ping.exe','-n 120 127.0.0.1'; $psi.UseShellExecute=$false; $psi.CreateNoWindow=$true; $psi.RedirectStandardOutput=$true; $c=[Diagnostics.Process]::Start($psi); Set-Content -Path $env:TEMP\\ghost-e2e-0244-child.txt -Value $c.Id; Start-Sleep 30", "timeout_ms": 2000}, "contains": "\"timed_out\":true", "max": 300},
{"exec": "type %TEMP%\\ghost-e2e-0244-child.txt", "capture": {"c0": "(\\d+)"}},
{"sleep": 1500},
{"exec": "tasklist /FI \"PID eq {{c0}}\" /NH", "contains": "No tasks"},
{"exec": "del %TEMP%\\ghost-e2e-0244-child.txt"},
{"note": "E/F persistent session: start, send, read, list, kill ends its child"},
{"tool": "ghost_shell", "args": {"op": "open", "id": "e2e"}, "expect": "ok", "max": 300},
{"tool": "ghost_shell", "args": {"op": "send", "id": "e2e", "cmd": "$x = 41; $x + 1"}, "expect": "ok", "contains": "42", "max": 300},
{"tool": "ghost_shell", "args": {"op": "send", "id": "e2e", "cmd": "$psi = New-Object System.Diagnostics.ProcessStartInfo 'ping.exe','-n 120 127.0.0.1'; $psi.UseShellExecute=$false; $psi.CreateNoWindow=$true; $psi.RedirectStandardOutput=$true; $global:c=[Diagnostics.Process]::Start($psi); 'CHILD=' + $c.Id"}, "expect": "ok", "capture": {"c2": "CHILD=(\\d+)"}, "max": 300},
{"exec": "tasklist /FI \"PID eq {{c2}}\" /NH", "contains": "PING.EXE"},
{"tool": "ghost_shell", "args": {"op": "list"}, "expect": "ok", "contains": "e2e", "max": 300},
{"tool": "ghost_shell", "args": {"op": "read", "id": "e2e"}, "expect": "ok", "max": 300},
{"tool": "ghost_shell", "args": {"op": "kill", "id": "e2e"}, "expect": "ok", "max": 300},
{"sleep": 1500},
{"exec": "tasklist /FI \"PID eq {{c2}}\" /NH", "contains": "No tasks"},
{"tool": "ghost_shell", "args": {"op": "list"}, "expect": "ok", "absent": "\"e2e\"", "max": 300},
{"note": "K2 a process-scoped stop ends a running persistent command and its child"},
{"tool": "ghost_shell", "args": {"op": "open", "id": "e2s"}, "expect": "ok", "max": 300},
{"tool": "ghost_shell", "args": {"op": "send", "id": "e2s", "cmd": "$psi = New-Object System.Diagnostics.ProcessStartInfo 'ping.exe','-n 120 127.0.0.1'; $psi.UseShellExecute=$false; $psi.CreateNoWindow=$true; $psi.RedirectStandardOutput=$true; $global:d=[Diagnostics.Process]::Start($psi); 'CHILD=' + $d.Id"}, "expect": "ok", "capture": {"c3": "CHILD=(\\d+)"}, "max": 300},
{"tool": "ghost_shell", "args": {"op": "send", "id": "e2s", "cmd": "Start-Sleep 60; 'slept'", "timeout_ms": 1000}, "max": 300},
{"exec": "tasklist /FI \"PID eq {{c3}}\" /NH", "contains": "PING.EXE"},
{"tool": "ghost_stop", "args": {"scope": "process"}, "expect": "ok"},
{"sleep": 2000},
{"exec": "tasklist /FI \"PID eq {{c3}}\" /NH", "contains": "No tasks"},
{"tool": "ghost_shell", "args": {"cmd": "Write-Output 'should be refused'"}, "expect": "err", "contains": "-32004", "max": 300},
{"tool": "ghost_reset", "args": {"scope": "process"}, "expect": "ok"},
{"tool": "ghost_shell", "args": {"op": "read", "id": "e2s"}, "max": 400},
{"tool": "ghost_shell", "args": {"op": "list"}, "expect": "ok", "max": 300},
{"tool": "ghost_shell", "args": {"cmd": "Write-Output 'after reset'"}, "expect": "ok", "contains": "after reset", "max": 300}
]}
