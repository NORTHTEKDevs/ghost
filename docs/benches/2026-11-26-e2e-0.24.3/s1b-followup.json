{"env": {"GHOST_SHELL": "off"}, "steps": [
{"note": "D2 type with value read-back (ValuePattern), negative control, key names"},
{"tool": "ghost_window", "args": {"op": "launch", "exe": "<repo>/target-improve/release/ghost-testbed.exe --title \"E2E Testbed 0243b\""}, "expect": "ok", "contains": "hidden desktop", "capture": {"pid": "\"pid\":(\\d+)"}, "max": 200},
{"sleep": 800},
{"tool": "ghost_assert", "args": {"predicate": "value-equals", "name": "Field", "text": "", "window": "E2E Testbed 0243b"}, "max": 400},
{"tool": "ghost_act", "args": {"action": "type", "name": "Field", "text": "e2e-0.24.3 typed", "window": "E2E Testbed 0243b"}, "expect": "ok", "contains": "\"verified\":true", "max": 300},
{"tool": "ghost_assert", "args": {"predicate": "value-equals", "name": "Field", "text": "e2e-0.24.3 typed", "window": "E2E Testbed 0243b"}, "expect": "ok", "max": 400},
{"tool": "ghost_wait", "args": {"for": "value", "name": "Field", "text": "e2e-0.24.3 typed", "window": "E2E Testbed 0243b", "timeout_ms": 3000}, "expect": "ok", "max": 400},
{"tool": "ghost_assert", "args": {"predicate": "value-equals", "name": "Field", "text": "something else", "window": "E2E Testbed 0243b"}, "expect": "err", "max": 400},
{"tool": "ghost_act", "args": {"action": "type", "name": "Field", "text": "second", "window": "E2E Testbed 0243b"}, "expect": "ok", "max": 300},
{"tool": "ghost_assert", "args": {"predicate": "value-contains", "name": "Field", "text": "second", "window": "E2E Testbed 0243b"}, "expect": "ok", "max": 400},
{"tool": "ghost_assert", "args": {"predicate": "value-contains", "name": "Field", "text": "secondsecond", "window": "E2E Testbed 0243b"}, "expect": "err", "max": 400},
{"tool": "ghost_act", "args": {"action": "type", "name": "Increment", "text": "x", "window": "E2E Testbed 0243b"}, "expect": "err", "max": 400},
{"tool": "ghost_find", "args": {"name": "Increment", "window": "E2E Testbed 0243b", "mode": "instant_only"}, "expect": "ok", "contains": "\"name\":\"Increment\"", "max": 200},
{"tool": "ghost_key", "args": {"keys": "NotAKey", "window": "E2E Testbed 0243b"}, "expect": "err", "contains": "-32602", "max": 400},
{"tool": "ghost_key", "args": {"keys": "End", "window": "E2E Testbed 0243b"}, "expect": "ok", "max": 300},
{"tool": "ghost_window", "args": {"op": "state", "name": "E2E Testbed 0243b", "state": "bogus"}, "expect": "err", "contains": "-32602", "max": 300},
{"tool": "ghost_wait", "args": {"for": "ms", "ms": 10, "timeout_ms": 999999999}, "expect": "err", "max": 300},
{"note": "H2 example.com body text"},
{"tool": "ghost_browser_launch", "args": {"id": "e2e2", "mode": "headless"}, "expect": "ok", "capture": {"bpid": "\"pid\":(\\d+)"}},
{"tool": "ghost_tab_open", "args": {"browser": "e2e2", "url": "https://example.com/"}, "expect": "ok", "capture": {"tab": "\"tab\":\"([0-9A-F]+)\""}},
{"tool": "ghost_tab_wait_for", "args": {"browser": "e2e2", "tab": "{{tab}}", "selector": "body"}, "max": 200},
{"tool": "ghost_tab_eval", "args": {"browser": "e2e2", "tab": "{{tab}}", "expression": "JSON.stringify({h1: document.querySelector('h1') && document.querySelector('h1').innerText, len: document.body.innerText.length, has: document.body.innerText.includes('Example Domain')})"}, "expect": "ok", "max": 300},
{"tool": "ghost_tab_text", "args": {"browser": "e2e2", "tab": "{{tab}}", "selector": "h1"}, "expect": "ok", "max": 300},
{"tool": "ghost_tab_navigate", "args": {"browser": "e2e2", "tab": "{{tab}}", "url": "https://nonexistent.invalid/"}, "expect": "err", "max": 300},
{"tool": "ghost_tab_close", "args": {"browser": "e2e2", "tab": "{{tab}}"}, "expect": "ok"},
{"tool": "ghost_browser_close", "args": {"id": "e2e2"}, "expect": "ok"},
{"tool": "ghost_desktop_close", "args": {"id": "auto"}, "expect": "ok", "contains": "terminated_pids"},
{"sleep": 1500},
{"exec": "tasklist /FI \"PID eq {{pid}}\" /NH", "contains": "No tasks"},
{"exec": "tasklist /FI \"PID eq {{bpid}}\" /NH", "contains": "No tasks"}
]}
